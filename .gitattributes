* text=auto eol=lf

# Binary assets (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.tiff binary
*.jks binary
*.keystore binary
*.rtf -text

# Generated catalog data: collapse in GitHub diffs / language stats
data_game/*.json linguist-generated=true

/.github/* export-ignore
.gitignore export-ignore
.gitattributes export-ignore

.idea/ export-ignore
.vscode/ export-ignore

/docs/My_Stuff.md export-ignore

*.csv export-ignore
*.log export-ignore
*.tmp export-ignore
.DS_Store export-ignore
Thumbs.db export-ignore
/build/ export-ignore
/dist/ export-ignore
/node_modules/ export-ignore
/vendor/ export-ignore
/.env export-ignore
